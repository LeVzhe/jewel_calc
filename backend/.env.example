# Скопируй в backend/.env и подставь ключи Cloudflare R2.
# Можно взять те же R2_*, что в foodbox: файлы этого проекта лежат в папке jewel_calc/components.
# POSTGRES_HOST и DATABASE_PORT ниже — для запуска API с хоста против контейнера db.
# Снаружи база опубликована на 47232. В контейнере API compose сам подставляет host=db и port=5432.

POSTGRES_USER=jewel
POSTGRES_PASSWORD=jewel
POSTGRES_DB=jewel_calc
POSTGRES_HOST=localhost
DATABASE_PORT=47232

R2_ACCESS_KEY_ID=cde18be7d7a6ace2ce8c8f61c90eadab
R2_SECRET_ACCESS_KEY=b3502903d9881c3da2adc05abb5131ea21860daac64a0efd6c6f29015c32537f
R2_ACCOUNT_ID=d45210353e2ef73f378ece5b9e0e89bf
R2_BUCKET_NAME=fafdbx-dev
R2_PUBLIC_BASE_URL=https://pub-ec6c8726e7d940e0b3b4ab07a917f4cb.r2.dev
